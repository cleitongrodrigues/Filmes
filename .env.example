# Exemplo de arquivo .env
# Copie este arquivo para .env e preencha com seus valores reais

# Backend Catálogo
PORT=3000
AUTH_SERVICE_URL=http://auth-service:3001

# Auth Service
AUTH_SERVICE_PORT=3001

# Banco de Dados (compartilhado entre backend e auth-service)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cine_magico
DB_DIALECT=mysql

# JWT Secret para assinatura de tokens
# IMPORTANTE: Use uma string longa e aleatória em produção
JWT_SECRET=seu-secret-key-muito-seguro-aqui-2024

# TMDB API - obtenha em https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua-chave-tmdb-aqui
TMDB_BASE_URL=https://api.themoviedb.org/3

# Mailtrap (Development) - obtenha em https://mailtrap.io
# Substitua pelos valores reais do seu account do Mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=seu-usuario-mailtrap-aqui
MAILTRAP_PASS=sua-senha-mailtrap-aqui
MAILTRAP_FROM=noreply@cinemagico.com

# URL do Frontend (para link de reset de senha)
FRONTEND_URL=http://localhost:8201

# Para Produção: Usar Brevo em vez de Mailtrap
# BREVO_API_KEY=xxx
# BREVO_SENDER_EMAIL=seu-email@seudominio.com
